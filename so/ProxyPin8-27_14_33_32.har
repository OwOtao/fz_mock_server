  <div class=\"content\">\n                    <p>Something has triggered missing webpage on your\n                    website. This is the default 404 error page for\n                    <strong>nginx</strong> that is distributed with\n                    EPEL.  It is located\n                    <tt>/usr/share/nginx/html/404.html</tt></p>\n\n                    <p>You should customize this error page for your own\n                    site or edit the <tt>error_page</tt> directive in\n                    the <strong>nginx</strong> configuration file\n                    <tt>/etc/nginx/nginx.conf</tt>.</p>\n\n                </div>\n            </div>\n\n            <div class=\"logos\">\n                <a href=\"http://nginx.net/\"><img\n                    src=\"/nginx-logo.png\"\n                    alt=\"[ Powered by nginx ]\"\n                    width=\"121\" height=\"32\" /></a>\n\n                <a href=\"http://fedoraproject.org/\"><img \n                    src=\"/poweredby.png\"\n                    alt=\"[ Powered by Fedora EPEL ]\"\n                    width=\"88\" height=\"31\" /></a>\n            </div>\n        </div>\n    </body>\n</html>\n"},"redirectURL":"","headersSize":-1,"bodySize":3652}},{"startedDateTime":"2026-08-27T06:27:09.794744Z","time":2155,"pageref":"ProxyPin","_id":"mtb54ew2UJY6ocMl","_app":{"id":"com.xhtt.app.fzjh","name":"放置江湖","path":"com.xhtt.app.fzjh","os":"android"},"request":{"method":"GET","url":"http://cdn.xiaohoutiaotiao.com/notice/kxyxzx/f780ad349de7056b96fb66acc1f486b7.html","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Host","value":"cdn.xiaohoutiaotiao.com"},{"name":"Proxy-Connection","value":"keep-alive"},{"name":"Upgrade-Insecure-Requests","value":"1"},{"name":"User-Agent","value":"Mozilla/5.0 (Linux; Android 14; 2512BPNDAC Build/UQ1A.240205.04271925; wv) AppleWebKit/537.36 (KHTML, like Gecko) Version/4.0 Chrome/146.0.7680.119 Mobile Safari/537.36"},{"name":"Accept","value":"text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.7"},{"name":"X-Requested-With","value":"com.xhtt.app.fzjh"},{"name":"Accept-Encoding","value":"gzip, deflate"},{"name":"Accept-Language","value":"zh-CN,zh;q=0.9,en-US;q=0.8,en;q=0.7"}],"queryString":[],"postData":{"mimeType":"","text":""},"headersSize":-1,"bodySize":0},"cache":{},"timings":{"send":0,"wait":2155,"receive":0},"serverIPAddress":"14.215.57.117","response":{"status":200,"statusText":"OK","httpVersion":"HTTP/1.1","cookies":[],"headers":[{"name":"Server","value":"Tengine"},{"name":"Content-Type","value":"text/html"},{"name":"Content-Length","value":"17284"},{"name":"Connection","value":"keep-alive"},{"name":"Set-Cookie","value":"acw_tc=0ed7392d17878120314014959e61cacb850414c3b2f995651ae4b18e7a;path=/;HttpOnly;Max-Age=3600"},{"name":"Set-Cookie","value":"cdn_sec_tc=0ed7392d17878120314014959e61cacb850414c3b2f995651ae4b18e7a;path=/;HttpOnly;Max-Age=3600"},{"name":"Date","value":"Thu, 27 Aug 2026 06:27:11 GMT"},{"name":"Last-Modified","value":"Thu, 27 Aug 2026 06:10:44 GMT"},{"name":"Vary","value":"Accept-Encoding"},{"name":"ETag","value":"\"6a8fd4e4-4384\""},{"name":"Accept-Ranges","value":"bytes"},{"name":"Via","value":"ens-cache9.l2ea134-3[52,51,200-0,H], ens-cache55.l2ea134-3[53,0], ens-cache55.l2ea134-3[54,0], ens-cache8.cn4460[78,78,200-0,M], ens-cache4.cn4460[82,0]"},{"name":"Age","value":"0"},{"name":"Ali-Swift-Global-Savetime","value":"1787812031"},{"name":"X-Cache","value":"MISS TCP_MISS dirn:-2:-2"},{"name":"X-Swift-SaveTime","value":"Thu, 27 Aug 2026 06:27:11 GMT"},{"name":"X-Swift-CacheTime","value":"98"},{"name":"Timing-Allow-Origin","value":"*"},{"name":"EagleId","value":"0ed7392d17878120314014959e"}],"content":{"size":17284,"mimeType":"text/html","text":"\n<!doctype html>\n<html>\n\t<head>\n\t\t<meta charset=\"utf-8\">\n\t\t<title>放置江湖公告系统</title>\n\t\t<meta name=\"viewport\" content=\"width=device-width\">\n\t\t<meta name=\"apple-mobile-web-app-capable\" content=\"yes\" />\n\t\t<meta name=\"keywords\" content=\"\" />\n\t\t<meta name=\"description\" content=\"\" />\n\t\t<meta name=\"format-detection\" content=\"telephone=no\" />\n\n\t\t<meta name=\"viewport\" content=\"width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no\">\n    \t<meta name=\"apple-mobile-web-app-capable\" content=\"yes\" />\n\t</head>\n\t<style type=\"text/css\">\n\thtml{color:rgb(208,208,208);}body{background-color: #000;}\t\n\ta:link, a:visited {\n        color:#38f;\n        text-decoration:underline;\n    }        \n    a:hover, a:active {\n        color:#2e82ff;\n        text-decoration:none;\n    }\n\tdiv.wrapper .notice-border{border:.08rem solid rgb(120,120,120);padding:10px;margin-bottom:.125rem;margin-top:.225rem}div.wrapper .notice .notice-title{text-align:center}div.wrapper .notice .notice-content{margin:.1rem}div.wrapper .notice .notice-time{font-size:.4rem;float:right}div.wrapper .notice .notice-collapse{font-size:.4rem;float:left}div.clear{clear:both}\n\t</style>\n\t<body style=\"font-size: 12px;word-wrap:break-word;word-break:break-all;\">\n\t\t<div id=\"touchable\">\n\t\t\t<div class=\"wrapper\"><div class=\"notice notice-border\"><div class=\"notice-title\"><h2>8月27日修复预告</h2></div><div class=\"notice-content\"><p><span style=\"text-wrap-mode: wrap; font-size: 14px; color: rgb(216, 216, 216);\">致大侠：</span></p><p><span style=\"text-wrap-mode: wrap; font-size: 14px; color: rgb(216, 216, 216);\">我们预计将于2026年8月27日<span style=\"text-wrap-mode: wrap; font-size: 14px; color: rgb(229, 185, 183);\">15:30-16:00</span>左右进行游戏优化更新。</span></p><p><span style=\"text-wrap-mode: wrap; font-size: 14px; color: rgb(216, 216, 216);\">本次更新修复派遣中出现网络异常导致卡死的情况。</span></p><p><span style=\"text-wrap-mode: wrap; font-size: 14px; color: rgb(216, 216, 216);\">为您带来的不便我们深表歉意，我们会在维护完成后为大家统一发放对应补偿，届时请前往设置-江湖邮驿界面领取。</span></p><p><span style=\"text-wrap-mode: wrap; font-size: 14px; color: rgb(216, 216, 216);\"><br/></span></p><p><span style=\"text-wrap-mode: wrap; font-size: 14px; color: rgb(216, 216, 216);\">补偿奖励如下：</span></p><p><span style=\"text-wrap-mode: wrap; font-size: 14px; color: rgb(216, 216, 216);\">静心丸*2、天香玉露*1、行功散*1、清风醉*1</span></p><p><span style=\"text-wrap-mode: wrap; font-size: 14px; color: rgb(216, 216, 216);\">笃志*100、勤建之志*100</span></p><p><span style=\"text-wrap-mode: wrap; font-size: 14px; color: rgb(216, 216, 216);\"><br/></span></p><p><span style=\"text-wrap-mode: wrap; font-size: 14px; color: rgb(216, 216, 216);\">具体更新内容请以实际更新为准。<span style=\"text-wrap-mode: wrap; font-size: 14px; color: rgb(229, 185, 183);\">更新时间段将无法进入游戏</span>，请诸位妥善安排好游戏时间，避免造成不必要的损失。</span></p><p><span style=\"text-wrap-mode: wrap; font-size: 14px; color: rgb(216, 216, 216);\">感谢各位的支持！</span></p><p><span style=\"text-wrap-mode: wrap; font-size: 14px; color: rgb(216, 216, 216);\"><br/></span></p><p style=\"text-align: right;\"><span style=\"text-wrap-mode: wrap; font-size: 14px; color: rgb(216, 216, 216);\">《放置江湖》运营团队</span></p><p style=\"text-align: right;\"><span style=\"text-wrap-mode: wrap; font-size: 14px; color: rgb(216, 216, 216);\">2026年8月27日</span></p><p><br/></p><br /><a class=\"link\" href=\"http://cdn.xiaohoutiaotiao.com/notice/kxyxzx/10fd3a9b60823039466899c6e1f3633a.html\">点击获取详情</a></div><div class=\"notice-time\">2026-08-27</div><div class=\"clear\"></div></div><div class=\"notice notice-border\"><div class=\"notice-title\"><h2>8月26日维护更新公告</h2></div><div class=\"notice-content\"><p><span style=\"text-wrap-mode: wrap; font-size: 14px; color: rgb(216, 216, 216);\">致大侠：</span></p><p><span style=\"text-wrap-mode: wrap; font-size: 14px; color: rgb(216, 216, 216);\"><br/></span></p><p><span style=\"text-wrap-mode: wrap; font-size: 14px; color: rgb(216, 216, 216);\">白露凝而秋气生，鸿雁南来，玄鸟归去。</span></p><p><span style=\"text-wrap-mode: wrap; font-size: 14px; color: rgb(216, 216, 216);\">草木初黄，露珠映月，正是一年中最澄澈的时节。</span></p><p><span style=\"text-wrap-mode: wrap; font-size: 14px; color: rgb(216, 216, 216);\">锋芒宜敛，剑气宜藏，静候霜降，再试新锋。</span></p><p><span style=\"text-wrap-mode: wrap; font-size: 14px; color: rgb(216, 216, 216);\"><br/></span></p><p><span style=\"text-wrap-mode: wrap; font-size: 14px; color: rgb(216, 216, 216);\">本次维护时间为：2026年8月26日<strong><span style=\"text-wrap-mode: wrap; font-size: 14px; color: rgb(229, 185, 183);\">17:30-18:30</span></strong><span style=\"text-wrap-mode: wrap; color: rgb(216, 216, 216); font-size: 12px;\">（维护时间段无法进入游戏）</span></span></p><p><span style=\"text-wrap-mode: wrap; font-size: 14px; color: rgb(216, 216, 216);\"><br/></span></p><p><span style=\"text-wrap-mode: wrap; font-size: 14px; color: rgb(216, 216, 216);\">为了提高游戏体验，本次更新内容如下：</span></p><p><a href=\"http://cdn.xiaohoutiaotiao.com/notice/ios/00883d7ca8853d2d333637ea510c104c.html\" target=\"_self\" style=\"text-wrap-mode: wrap; font-size: 14px; color: rgb(84, 141, 212); text-decoration: underline;\"><span style=\"text-wrap-mode: wrap; font-size: 14px; color: rgb(84, 141, 212);\">1.江湖秘宝（点击查看详情）;</span></a></p><p><a href=\"http://cdn.xiaohoutiaotiao.com/notice/ios/f22b1d5990e5b8752cd64292f440522f.html\" target=\"_self\" style=\"text-wrap-mode: wrap; font-size: 14px; color: rgb(84, 141, 212); text-decoration: underline;\"><span style=\"text-wrap-mode: wrap; font-size: 14px; color: rgb(84, 141, 212);\">2.江湖珍品阁（点击查看详情）;</span></a></p><p><a href=\"http://cdn.xiaohoutiaotiao.com/notice/ios/7fe1763b581298af897db4d61449c02a.html\" target=\"_self\" style=\"text-wrap-mode: wrap; font-size: 14px; color: rgb(84, 141, 212); text-decoration: underline;\"><span style=\"text-wrap-mode: wrap; font-size: 14px; color: rgb(84, 141, 212);\">3.充值福利（点击查看详情）;</span></a></p><p><a href=\"http://cdn.xiaohoutiaotiao.com/notice/ios/ff66327d800de0c3612b192764e948f7.html\" target=\"_self\" style=\"text-wrap-mode: wrap; font-size: 14px; color: rgb(84, 141, 212); text-decoration: underline;\"><span style=\"text-wrap-mode: wrap; font-size: 14px; color: rgb(84, 141, 212);\">4.名士之约（点击查看详情）;</span></a></p><p><a href=\"http://cdn.xiaohoutiaotiao.com/notice/ios/5b88722a2dbcd78f9824e6cb77698c5b.html\" target=\"_self\" style=\"text-wrap-mode: wrap; font-size: 14px; color: rgb(84, 141, 212); text-decoration: underline;\"><span style=\"text-wrap-mode: wrap; font-size: 14px; color: rgb(84, 141, 212);\">5.香囊密阁（点击查看详情）;</span></a></p><p><a href=\"http://cdn.xiaohoutiaotiao.com/notice/ios/5fc62ed87d63d542609213766d10499c.html\" target=\"_self\" style=\"text-wrap-mode: wrap; font-size: 14px; color: rgb(84, 141, 212); text-decoration: underline;\"><span style=\"text-wrap-mode: wrap; font-size: 14px; color: rgb(84, 141, 212);\">6.通武积市（点击查看详情）;</span></a></p><p><a href=\"http://cdn.xiaohoutiaotiao.com/notice/ios/45a5b97556f13c49e60ef0ae99988ef6.html\" target=\"_self\" style=\"text-wrap-mode: wrap; font-size: 14px; color: rgb(84, 141, 212); text-decoration: underline;\"><span style=\"text-wrap-mode: wrap; font-size: 14px; color: rgb(84, 141, 212);\">7.易金圩市（点击查看详情）;</span></a></p><p><a href=\"http://cdn.xiaohoutiaotiao.com/notice/ios/83d838654a59ca93d939db6ae62e9707.html\" target=\"_self\" style=\"text-wrap-mode: wrap; font-size: 14px; color: rgb(84, 141, 212); text-decoration: underline;\"><span style=\"text-wrap-mode: wrap; font-size: 14px; color: rgb(84, 141, 212);\">8.限时历练（点击查看详情）;</span></a></p><p><a href=\"http://cdn.xiaohoutiaotiao.com/notice/ios/307509d7f3f740d07fdb43e2e8d268e2.html\" target=\"_self\" style=\"text-wrap-mode: wrap; font-size: 14px; color: rgb(84, 141, 212); text-decoration: underline;\"><span style=\"text-wrap-mode: wrap; font-size: 14px; color: rgb(84, 141, 212);\">9.限时礼包（点击查看详情）;</span></a></p><p><a href=\"http://cdn.xiaohoutiaotiao.com/notice/ios/1973373c9a7b02d8e04b326623980ed0.html\" target=\"_self\" style=\"text-wrap-mode: wrap; font-size: 14px; color: rgb(84, 141, 212); text-decoration: underline;\"><span style=\"text-wrap-mode: wrap; font-size: 14px; color: rgb(84, 141, 212);\">10.充值积分兑换（点击查看详情）;</span></a></p><p><a href=\"http://cdn.xiaohoutiaotiao.com/notice/ios/61be18ab1f586b5a340358ac7ad17572.html\" target=\"_self\" style=\"text-wrap-mode: wrap; font-size: 14px; color: rgb(84, 141, 212); text-decoration: underline;\"><span style=\"text-wrap-mode: wrap; font-size: 14px; color: rgb(84, 141, 212);\">11.天缘奇盒（点击查看详情）;</span></a></p><p><a href=\"http://cdn.xiaohoutiaotiao.com/notice/ios/d24dece35f7a29efe463a8687134bc36.html\" target=\"_self\" style=\"text-wrap-mode: wrap; font-size: 14px; color: rgb(84, 141, 212); text-decoration: underline;\"><span style=\"text-wrap-mode: wrap; font-size: 14px; color: rgb(84, 141, 212);\">12.活动轶闻——无明中元（点击查看详情）;</span></a></p><p><span style=\"text-wrap-mode: wrap; font-size: 14px; color: rgb(216, 216, 216);\">13.活动相关：</span></p><p><span style=\"text-wrap-mode: wrap; font-size: 14px; color: rgb(216, 216, 216);\">(1)冥商新增了一批新的装备和家具。</span></p><p><span style=\"text-wrap-mode: wrap; font-size: 14px; color: rgb(216, 216, 216);\">(2)从2026年08月27日0点0分0秒开始，至2026年09月10日23点59分59秒，酆都地图24小时开放，期间取消时间进入限制。</span></p><p><span style=\"text-wrap-mode: wrap; font-size: 14px; color: rgb(216, 216, 216);\">(3)从2026年08月27日0点0分0秒开始，至2026年09月10日23点59分59秒，冥币周常活动产出的冥币在原基础上额外增加25%。</span></p><p><span style=\"text-wrap-mode: wrap; font-size: 14px; color: rgb(216, 216, 216);\">14.游戏优化：</span></p><p><span style=\"text-wrap-mode: wrap; font-size: 14px; color: rgb(216, 216, 216);\">(1)修复家园派遣中江湖送信和缉拿恶徒的潜能、碎银异常问题。</span></p><p><span style=\"text-wrap-mode: wrap; font-size: 14px; color: rgb(216, 216, 216);\">(2)修复家园派遣奖励异常问题。</span></p><p><span style=\"text-wrap-mode: wrap; font-size: 14px; color: rgb(216, 216, 216);\">(3)修复《贞龙隐渊心经》主动招式《拨乱反正》的血志层数描述错误问题。</span></p><p><span style=\"text-wrap-mode: wrap; font-size: 14px; color: rgb(216, 216, 216);\">(4)修复部分活动轶闻文本错误问题。</span></p><p><span style=\"text-wrap-mode: wrap; font-size: 14px; color: rgb(216, 216, 216);\">(5)修复排行榜屏蔽词异常问题，同时删除部分异常显示数据。</span></p><p><span style=\"text-wrap-mode: wrap; font-size: 14px; color: rgb(216, 216, 216);\">(6)修复领悟系统中残页异常分组问题。</span></p><p><span style=\"text-wrap-mode: wrap; font-size: 14px; color: rgb(216, 216, 216);\">(7)修复剧情中萧逸龙切磋步骤缺失人物导致卡死问题。</span></p><p><span style=\"text-wrap-mode: wrap; font-size: 14px; color: rgb(216, 216, 216);\">(8)修复部分情况下残页无法解锁主动招式的问题。</span></p><p><span style=\"text-wrap-mode: wrap; font-size: 14px; color: rgb(216, 216, 216);\"><br/></span></p><p><span style=\"text-wrap-mode: wrap; font-size: 14px; color: rgb(216, 216, 216);\">若有疑问请联系官方客服沟通解决。</span></p><p><span style=\"text-wrap-mode: wrap; font-size: 14px; color: rgb(216, 216, 216);\">感谢各位大侠对我们一如既往的支持和包容！</span></p><p><span style=\"text-wrap-mode: wrap; font-size: 14px; color: rgb(216, 216, 216);\"><br/></span></p><p style=\"text-align: right;\"><span style=\"text-wrap-mode: wrap; font-size: 14px; color: rgb(216, 216, 216);\">《放置江湖》运营团队</span></p><p style=\"text-align: right;\"><span style=\"text-wrap-mode: wrap; font-size: 14px; color: rgb(216, 216, 216);\">2026年8月26日</span></p><p><br/></p><br /><a class=\"link\" href=\"http://cdn.xiaohoutiaotiao.com/notice/kxyxzx/cabd8736e17dda9385235e21a40d6f52.html\">点击获取详情</a></div><div class=\"notice-time\">2026-08-26</div><div class=\"clear\"></div></div></div>\n\t\t</div>\n\t\t<script type=\"text/javascript\">\n\t\t\t!function(win, lib) {\n\t\t\tvar timer,\n\t\t\tdoc     = win.document,\n\t\t\tdocElem = doc.documentElement,\n\n\t\t\tvpMeta   = doc.querySelector('meta[name=\"viewport\"]'),\n\t\t\tflexMeta = doc.querySelector('meta[name=\"flexible\"]'),\n\n\t\t\tdpr   = 0,\n\t\t\tscale = 0,\n\n\t\t\tflexible = lib.flexible || (lib.flexible = {});\n\n\t\t\t// 设置了 viewport meta\n\t\t\tif (vpMeta) {\n\t\t\t\tvar initial = vpMeta.getAttribute(\"content\").match(/initial\\-scale=([\\d\\.]+)/);\n\n\t\t\t\tif (initial) {\n\t\t\t\t\tscale = parseFloat(initial[1]); // 已设置的 initialScale\n\t\t\t\t\tdpr = parseInt(1 / scale);      // 设备像素比 devicePixelRatio\n\t\t\t\t}\n\t\t\t}\n\t\t\t// 设置了 flexible Meta\n\t\t\telse if (flexMeta) {\n\t\t\t\tvar flexMetaContent = flexMeta.getAttribute(\"content\");\n\t\t\t\tif (flexMetaContent) {\n\n\t\t\t\t\tvar initial = flexMetaContent.match(/initial\\-dpr=([\\d\\.]+)/),\n\t\t\t\t\tmaximum = flexMetaContent.match(/maximum\\-dpr=([\\d\\.]+)/);\n\n\t\t\t\t\tif (initial) {\n\t\t\t\t\t\tdpr = parseFloat(initial[1]);\n\t\t\t\t\t\tscale = parseFloat((1 / dpr).toFixed(2));\n\t\t\t\t\t}\n\n\t\t\t\t\tif (maximum) {\n\t\t\t\t\t\tdpr = parseFloat(maximum[1]);\n\t\t\t\t\t\tscale = parseFloat((1 / dpr).toFixed(2));\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t}\n\n\t\t\t// viewport 或 flexible\n\t\t\t// meta 均未设置\n\t\t\tif (!dpr && !scale) {\n\t\t\t\t// QST\n\t\t\t\t// 这里的 第一句有什么用 ?\n\t\t\t\t// 和 Android 有毛关系 ?\n\t\t\t\tvar u = (win.navigator.appVersion.match(/android/gi), win.navigator.appVersion.match(/iphone/gi)),\n\t\t\t\t_dpr = win.devicePixelRatio;\n\n\t\t\t\t// 所以这里似乎是将所有 Android 设备都设置为 1 了\n\t\t\t\tdpr = u ? ( (_dpr >= 3 && (!dpr || dpr >= 3))\n\t\t\t\t? 3\n\t\t\t\t: (_dpr >= 2 && (!dpr || dpr >= 2))\n\t\t\t\t? 2\n\t\t\t\t: 1\n\t\t\t\t)\n\t\t\t\t: 1;\n\n\t\t\t\tscale = 1 / dpr;\n\t\t\t}\n\n\t\t\tvar userAgent = navigator.userAgent.toLowerCase();\n            var isIpad = userAgent.match(/ipad/i) == \"ipad\";\n            var isIphone = userAgent.match(/iphone/i) == \"iphone\";\n            if (isIpad) {dpr = 2;}        \n\n\t\t\tdocElem.setAttribute(\"data-dpr\", dpr);\n\n\t\t\t// 插入 viewport meta\n\t\t\tif (!vpMeta) {\n\t\t\t\tvpMeta = doc.createElement(\"meta\");\n\n\t\t\t\tvpMeta.setAttribute(\"name\", \"viewport\");\n\t\t\t\tvpMeta.setAttribute(\"content\",\n\t\t\t\t\"initial-scale=\" + scale + \", maximum-scale=\" + scale + \", minimum-scale=\" + scale + \", user-scalable=no\");\n\n\t\t\t\tif (docElem.firstElementChild) {\n\t\t\t\t\tdocElem.firstElementChild.appendChild(vpMeta)\n\t\t\t\t\t} else {\n\t\t\t\t\tvar div = doc.createElement(\"div\");\n\t\t\t\t\tdiv.appendChild(vpMeta);\n\t\t\t\t\tdoc.write(div.innerHTML);\n\t\t\t\t}\n\t\t\t}\n\n\t\t\tfunction setFontSize() {\n\t\t\t\tvar winWidth = docElem.getBoundingClientRect().width;\n\n\t\t\t\tif (winWidth / dpr > 540) {\n\t\t\t\t\t(winWidth = 540 * dpr);\n\t\t\t\t}\n\n\t\t\t\t// 根节点 fontSize 根据宽度决定\n\t\t\t\tvar baseSize = winWidth / 10;\n\n\t\t\t\tdocElem.style.fontSize = baseSize + \"px\";\n\t\t\t\tflexible.rem = win.rem = baseSize;\n\t\t\t}\n\n\t\t\t// 调整窗口时重置\n\t\t\twin.addEventListener(\"resize\", function() {\n\t\t\t\tclearTimeout(timer);\n\t\t\t\ttimer = setTimeout(setFontSize, 300);\n\t\t\t}, false);\n\n\n\t\t\t// 这一段是我自己加的\n\t\t\t// orientationchange 时也需要重算下吧\n\t\t\twin.addEventListener(\"orientationchange\", function() {\n\t\t\t\tclearTimeout(timer);\n\t\t\t\ttimer = setTimeout(setFontSize, 300);\n\t\t\t}, false);\n\n\n\t\t\t// pageshow\n\t\t\t// keyword: 倒退 缓存相关\n\t\t\twin.addEventListener(\"pageshow\", function(e) {\n\t\t\t\tif (e.persisted) {\n\t\t\t\t\tclearTimeout(timer);\n\t\t\t\t\ttimer = setTimeout(setFontSize, 300);\n\t\t\t\t}\n\t\t\t}, false);\n\n\t\t\t// 设置基准字体\n\t\t\tvar base_size = 12;\t\t\t\n\t\t\tvar w=parseInt(win.screen.width),\n\t\t\t\th=parseInt(win.screen.height);\n\t\t\tif (isIphone)\n\t\t\t{\n\t\t\t\tif (w==320&&h==480)\n\t\t\t\t{\n\t\t\t\t\tconsole.log(\"iphone4\");\n\t\t\t\t\tbase_size=6.2;\n\t\t\t\t}\n\t\t\t\telse if (w==320&&h==568)\n\t\t\t\t{\n\t\t\t\t\tconsole.log(\"iphone5\");\n\t\t\t\t\tbase_size=6.2;\n\t\t\t\t}\n\t\t\t\telse if (w==375&&h==667)\n\t\t\t\t{\n\t\t\t\t\tconsole.log(\"iphone6\");\n\t\t\t\t\tbase_size=7.5;\n\t\t\t\t}\n\t\t\t\telse if (w==414&&h==736)\n\t\t\t\t{\n\t\t\t\t\tconsole.log(\"iphone6s\");\n\t\t\t\t\tbase_size=5.5;\n\t\t\t\t}\t\t\t\t\n\t\t\t}\n\n\t\t\tif (\"complete\" === doc.readyState) \n\t\t\t{\n\t\t\t\tdoc.body.style.fontSize = base_size * dpr + \"px\";\n\t\t\t} \n\t\t\telse \n\t\t\t{\n\t\t\t\tdoc.addEventListener(\"DOMContentLoaded\", function() {\n\t\t\t\t\tdoc.body.style.fontSize = base_size * dpr + \"px\";\n\t\t\t\t}, false);\n\t\t\t}\n\n\t\t\tsetFontSize();\n\n\t\t\tflexible.dpr = win.dpr = dpr;\n\n\t\t\tflexible.refreshRem = setFontSize;\n\n\t\t\tflexible.rem2px = function(d) {\n\t\t\t\tvar c = parseFl