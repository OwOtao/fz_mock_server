\":\"xisuidan01\",\"price\":80,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":20,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":29,\"type\":[\"S\"],\"update_time\":\"2026-08-26 17:12:34\",\"gid\":300177,\"itype\":2,\"name\":\"臂力洗髓丹\",\"dsc\":\"这是一种特殊的丹药，十分名贵，据说可以用来洗髓，每次可以洗髓十点臂力，需要先天臂力达到三十点才可使用。\",\"times\":20},{\"id\":746348,\"sid\":12399,\"itemId\":\"xisuidan02\",\"price\":80,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":20,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":30,\"type\":[\"S\"],\"update_time\":\"2026-08-26 17:12:34\",\"gid\":300178,\"itype\":2,\"name\":\"根骨洗髓丹\",\"dsc\":\"这是一种特殊的丹药，十分名贵，据说可以用来洗髓，每次可以洗髓十点根骨，需要先天根骨达到三十点才可使用。\",\"times\":20},{\"id\":746349,\"sid\":12399,\"itemId\":\"xisuidan03\",\"price\":80,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":20,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":31,\"type\":[\"S\"],\"update_time\":\"2026-08-26 17:12:34\",\"gid\":300179,\"itype\":2,\"name\":\"身法洗髓丹\",\"dsc\":\"这是一种特殊的丹药，十分名贵，据说可以用来洗髓，每次可以洗髓十点身法，需要先天身法达到三十点才可使用。\",\"times\":20},{\"id\":746350,\"sid\":12399,\"itemId\":\"xisuidan04\",\"price\":80,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":20,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":32,\"type\":[\"S\"],\"update_time\":\"2026-08-26 17:12:34\",\"gid\":300180,\"itype\":2,\"name\":\"悟性洗髓丹\",\"dsc\":\"这是一种特殊的丹药，十分名贵，据说可以用来洗髓，每次可以洗髓十点悟性，需要先天悟性达到三十点才可使用。\",\"times\":20},{\"id\":746351,\"sid\":12399,\"itemId\":\"xisuidan05\",\"price\":10,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":60,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":33,\"type\":[\"S\"],\"update_time\":\"2026-08-26 17:12:35\",\"gid\":300181,\"itype\":2,\"name\":\"臂力洗髓丹(小)\",\"dsc\":\"这是一种特殊的丹药，十分名贵，据说可以用来洗髓，每次可以洗髓一点臂力，需要先天臂力达到三十点才可使用。\",\"times\":60},{\"id\":746352,\"sid\":12399,\"itemId\":\"xisuidan06\",\"price\":10,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":60,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":34,\"type\":[\"S\"],\"update_time\":\"2026-08-26 17:12:35\",\"gid\":300182,\"itype\":2,\"name\":\"根骨洗髓丹(小)\",\"dsc\":\"这是一种特殊的丹药，十分名贵，据说可以用来洗髓，每次可以洗髓一点根骨，需要先天根骨达到三十点才可使用。\",\"times\":60},{\"id\":746353,\"sid\":12399,\"itemId\":\"xisuidan07\",\"price\":10,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":60,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":35,\"type\":[\"S\"],\"update_time\":\"2026-08-26 17:12:35\",\"gid\":300183,\"itype\":2,\"name\":\"身法洗髓丹(小)\",\"dsc\":\"这是一种特殊的丹药，十分名贵，据说可以用来洗髓，每次可以洗髓一点身法，需要先天身法达到三十点才可使用。\",\"times\":60},{\"id\":746354,\"sid\":12399,\"itemId\":\"xisuidan08\",\"price\":10,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":60,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":36,\"type\":[\"S\"],\"update_time\":\"2026-08-26 17:12:35\",\"gid\":300184,\"itype\":2,\"name\":\"悟性洗髓丹(小)\",\"dsc\":\"这是一种特殊的丹药，十分名贵，据说可以用来洗髓，每次可以洗髓一点悟性，需要先天悟性达到三十点才可使用。\",\"times\":60},{\"id\":746369,\"sid\":12399,\"itemId\":\"liuyunganlus\",\"price\":200,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":10,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":21,\"type\":[\"S\"],\"update_time\":\"2026-08-26 17:12:35\",\"gid\":300248,\"itype\":1,\"name\":\"流云甘露(5瓶)\",\"dsc\":\"这是一个精美的小盒子，里面装着5瓶流云甘露。\",\"times\":10},{\"id\":746370,\"sid\":12399,\"itemId\":\"zhounianqidaoju4\",\"price\":300,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":10,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":22,\"type\":[\"S\"],\"update_time\":\"2026-08-26 17:12:35\",\"gid\":300249,\"itype\":1,\"name\":\"天香玉露(10瓶)\",\"dsc\":\"内藏十瓶天香玉露，据说使用后会提升人物的精力。\",\"times\":10},{\"id\":746371,\"sid\":12399,\"itemId\":\"zhounianqidaoju1\",\"price\":250,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":30,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":23,\"type\":[\"T\",\"S\"],\"update_time\":\"2026-08-26 17:12:35\",\"gid\":300250,\"itype\":1,\"name\":\"潜能丹(5颗)\",\"dsc\":\"内藏五颗潜能丹,潜能丹使用后会提升大量人物潜能。\",\"times\":30},{\"id\":746372,\"sid\":12399,\"itemId\":\"zhounianqidaoju3\",\"price\":350,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":20,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":24,\"type\":[\"T\",\"S\"],\"update_time\":\"2026-08-26 17:12:35\",\"gid\":300251,\"itype\":1,\"name\":\"静心丸(10瓶)\",\"dsc\":\"内藏十瓶静心丸，静心丸使用后可以提升闭关修炼成功率，并且不会走火入魔。\",\"times\":20},{\"id\":746373,\"sid\":12399,\"itemId\":\"jingmaiyangcheng2\",\"price\":400,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":5,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":25,\"type\":[\"S\"],\"update_time\":\"2026-08-26 17:12:35\",\"gid\":300252,\"itype\":1,\"name\":\"经脉修复包\",\"dsc\":\"这里面包含了许多修复经脉所需的物品，包含经脉丹20个，真气丹10个，安神丹5个，渡元丹1个。\",\"times\":5},{\"id\":746374,\"sid\":12399,\"itemId\":\"jingmaiyangcheng3\",\"price\":400,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":5,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":26,\"type\":[\"S\"],\"update_time\":\"2026-08-26 17:12:35\",\"gid\":300253,\"itype\":1,\"name\":\"经脉养成包\",\"dsc\":\"这里面包含了许多养成经脉所需的物品，包含醒身丸20个，特制檀香3个，渡元丹2个。\",\"times\":5},{\"id\":746375,\"sid\":12399,\"itemId\":\"jingmaiyangcheng1\",\"price\":400,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":5,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":27,\"type\":[\"S\"],\"update_time\":\"2026-08-26 17:12:35\",\"gid\":300254,\"itype\":1,\"name\":\"经脉提升包\",\"dsc\":\"这里面包含了许多提升经脉所需的物品，包含醒身丸10个，真气丹10个，春元丹3个，安神丹10个。\",\"times\":5},{\"id\":746376,\"sid\":12399,\"itemId\":\"dingzhiwan\",\"price\":60,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":5,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":28,\"type\":[\"T\",\"S\"],\"update_time\":\"2026-08-26 17:12:35\",\"gid\":300255,\"itype\":2,\"name\":\"定志丸\",\"dsc\":\"只有服药者体内存在来自他人的内力时，才能抵御此药引起的真气紊乱，否则内力尽失；经脉培元时使用、提高获得特殊经脉天赋的几率，需要至少传承一次。\",\"times\":5}],\"wuxue\":[{\"id\":746322,\"sid\":12399,\"itemId\":\"xinbawangqiangfa\",\"price\":4000,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":1,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":44,\"type\":[\"T\",\"W\"],\"update_time\":\"2026-08-26 17:12:34\",\"gid\":200007,\"itype\":1,\"name\":\"霸王枪法\",\"dsc\":\"相传这是昔日楚霸王所使的枪法，招式大开大合一往无前。霸王天生神力，单手持枪比寻常人双手持枪还要灵活。\",\"times\":1},{\"id\":746323,\"sid\":12399,\"itemId\":\"yidaoliu\",\"price\":4000,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":1,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":43,\"type\":[\"T\",\"W\"],\"update_time\":\"2026-08-26 17:12:34\",\"gid\":200024,\"itype\":1,\"name\":\"一刀流\",\"dsc\":\"名震日本的武学，集东瀛剑道的精华，并吸收了一些中原武学的优点，既有刀法的凌厉，也有剑法的迅捷。\",\"times\":1},{\"id\":746324,\"sid\":12399,\"itemId\":\"chunjieleiji4\",\"price\":4000,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":1,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":45,\"type\":[\"T\",\"W\"],\"update_time\":\"2026-08-26 17:12:34\",\"gid\":200025,\"itype\":1,\"name\":\"虚空踏步\",\"dsc\":\"此功非内力深厚之人不可练，练至高深之处，可虚空连踏数十步，精妙无比。\",\"times\":1},{\"id\":746325,\"sid\":12399,\"itemId\":\"jiulongbianfa\",\"price\":3000,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":1,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":47,\"type\":[\"T\",\"W\"],\"update_time\":\"2026-08-26 17:12:34\",\"gid\":200028,\"itype\":1,\"name\":\"九龙鞭法\",\"dsc\":\"淮南一老武师所创，此鞭法之精髓在于，虽只一鞭在手，但施展之时，却犹如九条鞭子齐攻对手，使对手防无可防，遂得名九龙鞭法。\",\"times\":1},{\"id\":746326,\"sid\":12399,\"itemId\":\"yuanxiaoleiji4\",\"price\":4000,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":1,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":40,\"type\":[\"T\",\"W\"],\"update_time\":\"2026-08-26 17:12:34\",\"gid\":200045,\"itype\":1,\"name\":\"五行遁法\",\"dsc\":\"五行遁法源自《遁甲天书》，相传此书乃是乌角先生得天所授，却也不知真假，习得此术者每日可使用七七四十九次遁地之术。\",\"times\":1},{\"id\":746327,\"sid\":12399,\"itemId\":\"yuanxiaoleiji3\",\"price\":4000,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":1,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":39,\"type\":[\"T\",\"W\"],\"update_time\":\"2026-08-26 17:12:34\",\"gid\":200055,\"itype\":1,\"name\":\"长生诀(金)\",\"dsc\":\"江湖失传已久的神功，因久未使用，如今存放于该宝箱中，打开即可获得对应武功残篇。\",\"times\":1},{\"id\":746328,\"sid\":12399,\"itemId\":\"chunjieleiji2\",\"price\":4000,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":1,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":41,\"type\":[\"T\",\"W\"],\"update_time\":\"2026-08-26 17:12:34\",\"gid\":200056,\"itype\":1,\"name\":\"太玄经\",\"dsc\":\"这是江湖先贤从西汉扬雄所著的《太玄经》中悟出的部分武学，玄妙无比，非常人所能修炼。可与梦天掌互备。\",\"times\":1},{\"id\":746329,\"sid\":12399,\"itemId\":\"jiayishengong\",\"price\":4000,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":1,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":42,\"type\":[\"W\"],\"update_time\":\"2026-08-26 17:12:34\",\"gid\":200057,\"itype\":1,\"name\":\"焕衣神功\",\"dsc\":\"此内功心法讲究破而后立，据说修炼者需经历重重磨难才有希望神功大成，一旦大成，几同脱胎换骨、超凡入圣。\",\"times\":1},{\"id\":746330,\"sid\":12399,\"itemId\":\"caiweijianfabox1\",\"price\":5000,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":1,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":46,\"type\":[\"T\",\"W\"],\"update_time\":\"2026-08-26 17:12:34\",\"gid\":200058,\"itype\":1,\"name\":\"采薇剑法\",\"dsc\":\"相传，孤竹国国君的二位皇子为反对周王的主张，不食周粟。兄弟二人隐居首阳山采薇而食，创下这门名留青史的采薇剑法。\",\"times\":1},{\"id\":746331,\"sid\":12399,\"itemId\":\"tiancantuifa\",\"price\":4000,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":1,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":48,\"type\":[\"T\",\"W\"],\"update_time\":\"2026-08-26 17:12:34\",\"gid\":200059,\"itype\":1,\"name\":\"天残腿法\",\"dsc\":\"天残腿法相传乃是数百年前的天残老人所创，其招式灵动飘逸，劲力极大，是一门极为高深的武学。\",\"times\":1},{\"id\":746332,\"sid\":12399,\"itemId\":\"yuenvjianfabox1\",\"price\":5000,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":1,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":49,\"type\":[\"T\",\"W\"],\"update_time\":\"2026-08-26 17:12:34\",\"gid\":200060,\"itype\":1,\"name\":\"越女剑法\",\"dsc\":\"相传，越国有位姑娘从白猿身上领悟了一套剑法，女子来到军中，将剑法传于士兵，却不肯留下姓名。后来，人们便将这套剑法称为越女剑法。\",\"times\":1},{\"id\":746333,\"sid\":12399,\"itemId\":\"bdjhmiji\",\"price\":1000,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":3,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":54,\"type\":[\"T\",\"W\"],\"update_time\":\"2026-08-26 17:12:34\",\"gid\":200061,\"itype\":1,\"name\":\"拔刀居合秘籍\",\"dsc\":\"这是一本一刀流的秘籍，内有一刀流的绝学招式——拔刀斩、居合斩的秘籍残页各十张。\",\"times\":3},{\"id\":746334,\"sid\":12399,\"itemId\":\"bawangmiji\",\"price\":1000,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":3,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":55,\"type\":[\"T\",\"W\"],\"update_time\":\"2026-08-26 17:12:34\",\"gid\":200062,\"itype\":1,\"name\":\"霸王秘籍\",\"dsc\":\"这是一本霸王枪法的秘籍，内有霸王枪法的绝学招式——力拔山兮的秘籍残页十张。\",\"times\":3},{\"id\":746335,\"sid\":12399,\"itemId\":\"niekongbumiji\",\"price\":1000,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":3,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":56,\"type\":[\"T\",\"W\"],\"update_time\":\"2026-08-26 17:12:34\",\"gid\":200063,\"itype\":1,\"name\":\"蹑空步秘籍\",\"dsc\":\"这是一本蹑空步的秘籍，内有虚空踏步绝学招式——蹑空步的秘籍残页十张。\",\"times\":3},{\"id\":746336,\"sid\":12399,\"itemId\":\"caiweimiji\",\"price\":1000,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":3,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":57,\"type\":[\"T\",\"W\"],\"update_time\":\"2026-08-26 17:12:34\",\"gid\":200064,\"itype\":1,\"name\":\"采薇秘籍\",\"dsc\":\"这是一本采薇剑法的秘籍，内有采薇剑法的绝学招式——孤竹傲、首阳归的秘籍残页各十张。\",\"times\":3},{\"id\":746337,\"sid\":12399,\"itemId\":\"jiulongshitianmiji\",\"price\":800,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":2,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":58,\"type\":[\"T\",\"W\"],\"update_time\":\"2026-08-26 17:12:34\",\"gid\":200065,\"itype\":1,\"name\":\"九龙噬天秘籍\",\"dsc\":\"这是九龙鞭法的秘籍，内有九龙鞭法的绝学招式——九龙噬天的秘籍残页十张。\",\"times\":2},{\"id\":746338,\"sid\":12399,\"itemId\":\"tiancanmiji\",\"price\":800,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":3,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":59,\"type\":[\"T\",\"W\"],\"update_time\":\"2026-08-26 17:12:34\",\"gid\":200066,\"itype\":1,\"name\":\"天残秘籍\",\"dsc\":\"这是一本天残秘籍，内有天残腿法的绝学招式——天残地缺的秘籍残页十张。\",\"times\":3},{\"id\":746339,\"sid\":12399,\"itemId\":\"jiayimiji\",\"price\":800,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":3,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":60,\"type\":[\"T\",\"W\"],\"update_time\":\"2026-08-26 17:12:34\",\"gid\":200067,\"itype\":1,\"name\":\"破立秘籍\",\"dsc\":\"这是一本焕衣神功的秘籍，内有焕衣神功的绝学招式——破而后立的秘籍残页十张。\",\"times\":3},{\"id\":746340,\"sid\":12399,\"itemId\":\"taixuangongmiji\",\"price\":1000,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":3,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":61,\"type\":[\"T\",\"W\"],\"upda