{\"id\":746368,\"sid\":12399,\"itemId\":\"shenbingbox7\",\"price\":500,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":5,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":20,\"type\":[\"H\"],\"update_time\":\"2026-08-26 17:12:35\",\"gid\":300247,\"itype\":1,\"name\":\"暗器精炼箱\",\"dsc\":\"这是一个古朴的铁箱子。打开后可获得20个暗器类神兵淬炼材料。\",\"times\":5}],\"guashi\":[{\"id\":746403,\"sid\":12399,\"itemId\":\"waiguan1\",\"price\":3000,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":1,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":77,\"type\":[\"G\"],\"update_time\":\"2026-08-26 17:12:35\",\"gid\":700015,\"itype\":1,\"name\":\"藤木坠\",\"dsc\":\"一条藤木坠，略微粗糙的手艺雕琢而成，造型奇特而古怪。\",\"times\":1},{\"id\":746404,\"sid\":12399,\"itemId\":\"waiguan2\",\"price\":800,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":1,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":78,\"type\":[\"G\"],\"update_time\":\"2026-08-26 17:12:35\",\"gid\":700016,\"itype\":1,\"name\":\"竹编斗笠\",\"dsc\":\"一顶竹编斗笠，平平无奇，但江湖中似乎有个不成文的规定，凡戴斗笠的，多半都是“高手”。\",\"times\":1},{\"id\":746405,\"sid\":12399,\"itemId\":\"waiguan3\",\"price\":1000,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":1,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":79,\"type\":[\"G\"],\"update_time\":\"2026-08-26 17:12:35\",\"gid\":700017,\"itype\":1,\"name\":\"铁手环\",\"dsc\":\"普通的铁手环，并无什么花样，但于习武之人而言，它既可是一件伤人利器，也可增强手臂防护。\",\"times\":1},{\"id\":746406,\"sid\":12399,\"itemId\":\"waiguan4\",\"price\":1000,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":1,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":80,\"type\":[\"G\"],\"update_time\":\"2026-08-26 17:12:35\",\"gid\":700018,\"itype\":1,\"name\":\"银带钩\",\"dsc\":\"一个银带钩，细长短小，呈匍匐的兽状，因为年代久远，边角略有磨损，但可以看出是出自巧匠之手。\",\"times\":1},{\"id\":746407,\"sid\":12399,\"itemId\":\"waiguan5\",\"price\":1000,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":1,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":81,\"type\":[\"G\"],\"update_time\":\"2026-08-26 17:12:35\",\"gid\":700019,\"itype\":1,\"name\":\"同心结\",\"dsc\":\"用红色锦带编成连环回纹的花样，因其两结相连，取永结同心之意，七夕节常被用来向心仪之人表白。\",\"times\":1},{\"id\":746408,\"sid\":12399,\"itemId\":\"waiguan7\",\"price\":3000,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":1,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":82,\"type\":[\"G\"],\"update_time\":\"2026-08-26 17:12:35\",\"gid\":700020,\"itype\":1,\"name\":\"春晓披风\",\"dsc\":\"一件靛青色的棉布披风，厚度略薄，形制普通，坊市的布庄里随处可见。\",\"times\":1},{\"id\":746409,\"sid\":12399,\"itemId\":\"waiguan9\",\"price\":3000,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":1,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":83,\"type\":[\"G\"],\"update_time\":\"2026-08-26 17:12:35\",\"gid\":700021,\"itype\":1,\"name\":\"浮云伞\",\"dsc\":\"上绘浮云数朵的油纸伞，伞架和伞柄以上等的嫩竹经多道工序制成。易于开合，结实耐用。\",\"times\":1}],\"mianju\":[{\"id\":746315,\"sid\":12399,\"itemId\":\"mianju1029\",\"price\":1800,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":1,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":74,\"type\":[\"M\"],\"update_time\":\"2026-08-26 17:12:34\",\"gid\":100042,\"itype\":1,\"name\":\"盈姑娘\",\"dsc\":\"这是一张盈姑娘的戏曲面具，乃是江湖艺人所制，其质地光滑细腻，也不知是由什么制作而成的。\",\"times\":1},{\"id\":746316,\"sid\":12399,\"itemId\":\"mianju1075\",\"price\":2400,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":1,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":75,\"type\":[\"M\"],\"update_time\":\"2026-08-26 17:12:34\",\"gid\":100049,\"itype\":1,\"name\":\"蓉姑娘\",\"dsc\":\"这是一张蓉姑娘的戏曲面具，乃是江湖艺人所制，其质地光滑细腻，也不知是由什么制作而成的。\",\"times\":1},{\"id\":746317,\"sid\":12399,\"itemId\":\"mianju1012\",\"price\":1750,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":1,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":73,\"type\":[\"M\"],\"update_time\":\"2026-08-26 17:12:34\",\"gid\":100084,\"itype\":1,\"name\":\"杨大侠\",\"dsc\":\"这是一张杨大侠的戏曲面具，乃是江湖艺人所制，其质地光滑细腻，也不知是由什么制作而成的。\",\"times\":1},{\"id\":746318,\"sid\":12399,\"itemId\":\"mianju1101\",\"price\":1500,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":1,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":72,\"type\":[\"M\"],\"update_time\":\"2026-08-26 17:12:34\",\"gid\":100146,\"itype\":1,\"name\":\"厌胜老祖\",\"dsc\":\"这是一张厌胜老祖的戏曲面具，乃是江湖艺人所制，其质地光滑细腻，也不知是由什么制作而成的。\",\"times\":1},{\"id\":746319,\"sid\":12399,\"itemId\":\"mianju1009\",\"price\":600,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":1,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":71,\"type\":[\"M\"],\"update_time\":\"2026-08-26 17:12:34\",\"gid\":100159,\"itype\":1,\"name\":\"苗姑娘\",\"dsc\":\"这是一张苗姑娘的戏曲面具，乃是江湖艺人所制，其质地光滑细腻，也不知是由什么制作而成的。\",\"times\":1},{\"id\":746320,\"sid\":12399,\"itemId\":\"mianju1008\",\"price\":600,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":1,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":70,\"type\":[\"M\"],\"update_time\":\"2026-08-26 17:12:34\",\"gid\":100169,\"itype\":1,\"name\":\"郭小姐\",\"dsc\":\"这是一张郭小姐的戏曲面具，乃是江湖艺人所制，其质地光滑细腻，也不知是由什么制作而成的。\",\"times\":1},{\"id\":746321,\"sid\":12399,\"itemId\":\"mianju1265\",\"price\":3000,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":1,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":76,\"type\":[\"M\"],\"update_time\":\"2026-08-26 17:12:34\",\"gid\":100225,\"itype\":1,\"name\":\"飞将\",\"dsc\":\"这是一张飞将的戏曲面具，乃是江湖艺人所制，其质地光滑细腻，也不知是由什么制作而成的。\",\"times\":1}],\"default\":[{\"id\":746342,\"sid\":12399,\"itemId\":\"jiu106\",\"price\":160,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":10,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":6,\"type\":[\"T\",\"D\"],\"update_time\":\"2026-08-26 17:12:34\",\"gid\":300003,\"itype\":1,\"name\":\"醉梦生\",\"dsc\":\"这是一坛醉梦生，相传此酒可以让人忘却烦恼，醉生梦死。\",\"times\":10},{\"id\":746343,\"sid\":12399,\"itemId\":\"xinggongsan\",\"price\":50,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":30,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":37,\"type\":[\"D\"],\"update_time\":\"2026-08-26 17:12:34\",\"gid\":300005,\"itype\":1,\"name\":\"行功散\",\"dsc\":\"可减少练功时间一小时。\",\"times\":30},{\"id\":746344,\"sid\":12399,\"itemId\":\"tiangongshi1\",\"price\":100,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":10,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":4,\"type\":[\"D\"],\"update_time\":\"2026-08-26 17:12:34\",\"gid\":300014,\"itype\":1,\"name\":\"天工石\",\"dsc\":\"这是一颗天工石,可以用于提升装饰箱的容量。\",\"times\":10},{\"id\":746346,\"sid\":12399,\"itemId\":\"putizi1\",\"price\":75,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":30,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":94,\"type\":[\"T\",\"D\"],\"update_time\":\"2026-08-26 17:12:34\",\"gid\":300037,\"itype\":1,\"name\":\"菩提子\",\"dsc\":\"菩提子使用可提升快速提升内力值。\",\"times\":30},{\"id\":746359,\"sid\":12399,\"itemId\":\"jiaozifudai01\",\"price\":50,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":10,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":5,\"type\":[\"D\"],\"update_time\":\"2026-08-26 17:12:35\",\"gid\":300238,\"itype\":2,\"name\":\"八方通行福袋\",\"dsc\":\"打开福袋后，可随机获得20到40个游字令。\",\"times\":10},{\"id\":746360,\"sid\":12399,\"itemId\":\"zgwine1\",\"price\":500,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":5,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":7,\"type\":[\"D\"],\"update_time\":\"2026-08-26 17:12:35\",\"gid\":300239,\"itype\":1,\"name\":\"周公酒箱\",\"dsc\":\"这是一个周公酒酒箱，里面装着12瓶寻常难见的周公酒，可以说是宝物一件了。\",\"times\":5},{\"id\":746361,\"sid\":12399,\"itemId\":\"drxianglu03\",\"price\":990,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":1,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":8,\"type\":[\"D\"],\"update_time\":\"2026-08-26 17:12:35\",\"gid\":300240,\"itype\":2,\"name\":\"银月炉\",\"dsc\":\"以纯银制成的熏香炉，炉面光滑，白若霜雪。\",\"times\":1},{\"id\":746362,\"sid\":12399,\"itemId\":\"drxianglu04\",\"price\":1500,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":1,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":9,\"type\":[\"D\"],\"update_time\":\"2026-08-26 17:12:35\",\"gid\":300241,\"itype\":1,\"name\":\"金炽炉\",\"dsc\":\"纯金制成的熏香炉，正面刻朱雀神兽。\",\"times\":1},{\"id\":746363,\"sid\":12399,\"itemId\":\"menkecard1\",\"price\":180,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":20,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":10,\"type\":[\"D\"],\"update_time\":\"2026-08-26 17:12:35\",\"gid\":300242,\"itype\":2,\"name\":\"沧浪帖\",\"dsc\":\"这是一张烫金拜帖，在江湖中享有盛名，很多人梦寐以求。带着它去拜访苏州的沧浪居士，可了解门客招募事宜，使用后需当天完成招募。若不满足招募条件，则无法招募对应门客。\",\"times\":20},{\"id\":746364,\"sid\":12399,\"itemId\":\"duanzaobooks2\",\"price\":1000,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":10,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":11,\"type\":[\"D\"],\"update_time\":\"2026-08-26 17:12:35\",\"gid\":300243,\"itype\":1,\"name\":\"锻造图谱盒\",\"dsc\":\"这是一个锻造图谱盒，打开后可以获得1本锻造图谱（只会获得高级或顶级锻造图谱）。\",\"times\":10},{\"id\":746365,\"sid\":12399,\"itemId\":\"baixuehuicuibox01\",\"price\":500,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":10,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":12,\"type\":[\"T\",\"D\"],\"update_time\":\"2026-08-26 17:12:35\",\"gid\":300244,\"itype\":1,\"name\":\"百学荟萃箱\",\"dsc\":\"少侠可开出相马术、炼丹术、占星术、追踪术、鲁班术、相面术、仵作术、岐黄之术、墨家机关术、庙算之术、武穆遗书秘籍中的一种。\",\"times\":10},{\"id\":746378,\"sid\":12399,\"itemId\":\"jiaren005\",\"price\":6000,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":1,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":3,\"type\":[\"D\"],\"update_time\":\"2026-08-26 17:12:35\",\"gid\":300257,\"itype\":2,\"name\":\"鲁班奇偶\",\"dsc\":\"传闻此物乃天工巧匠鲁班所传至宝，形态栩栩如生，全身各处布有精密机关，构造巧妙。年代久远，却不见丝毫锈迹和腐坏！\",\"times\":1},{\"id\":746379,\"sid\":12399,\"itemId\":\"newfudai238\",\"price\":10,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":40,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":1,\"type\":[\"T\",\"D\"],\"update_time\":\"2026-08-26 17:12:35\",\"gid\":301313,\"itype\":1,\"name\":\"江湖桂月福袋\",\"dsc\":\"凭运气能开出戏曲面具(孔明)，玉露项链、流云甘露、行功散、静心丸、碎银、黄金、潜能丹、遁地符中的一种。\",\"times\":40},{\"id\":746380,\"sid\":12399,\"itemId\":\"newfudai239\",\"price\":60,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":30,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":2,\"type\":[\"T\",\"D\"],\"update_time\":\"2026-08-26 17:12:35\",\"gid\":301314,\"itype\":1,\"name\":\"江湖仲秋福袋\",\"dsc\":\"凭运气能开出戏曲面具(山鬼)、天马、虎蛟、行功散、门派顶级残页、干草人偶、静心丸、潜能丹、黄金中的一种。\",\"times\":30},{\"id\":746381,\"sid\":12399,\"itemId\":\"ningshendan\",\"price\":5,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":300,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":95,\"type\":[\"T\",\"D\"],\"update_time\":\"2026-08-26 17:12:35\",\"gid\":400002,\"itype\":10,\"name\":\"凝神丹\",\"dsc\":\"一颗褐色浑圆的丹药，散发出淡淡的药味，服用后静心凝神，练功事半功倍。\",\"times\":300},{\"id\":746382,\"sid\":12399,\"itemId\":\"accpoint\",\"price\":5,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":600,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":93,\"type\":[\"T\",\"D\"],\"update_time\":\"2026-08-26 17:12:35\",\"gid\":400003,\"itype\":6,\"name\":\"固身元气\",\"dsc\":\"养气固身，神采焕发，做什么都必然倍道而进。\",\"times\":600},{\"id\":746383,\"sid\":12399,\"itemId\":\"minditem4\",\"price\":1880,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":3,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":92,\"type\":[\"T\",\"D\"],\"update_time\":\"2026-08-26 17:12:35\",\"gid\":400004,\"itype\":6,\"name\":\"聚心丹\",\"dsc\":\"一个精致的紫金葫芦中装着的丹药，取之伴有阵阵奇特香气，相传服用此丹可使人神清气爽心旷神怡。\",\"times\":3},{\"id\":746384,\"sid\":12399,\"itemId\":\"minditem2\",\"price\":380,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":3,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":90,\"type\":[\"T\",\"D\"],\"update_time\":\"2026-08-26 17:12:35\",\"gid\":400006,\"itype\":6,\"name\":\"谧心丸\",\"dsc\":\"通体青色的药丸，闻之似有淡淡幽香，服用后可使人心神安定。\",\"times\":3},{\"id\":746385,\"sid\":12399,\"itemId\":\"minditem1\",\"price\":190,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":3,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":89,\"type\":[\"T\",\"D\"],\"update_time\":\"2026-08-26 17:12:35\",\"gid\":400009,\"itype\":6,\"name\":\"清心散\",\"dsc\":\"一包用白色油纸包裹的朱色粉末，据说出自名声显赫的医药世家，服用可令人舒心安神。\",\"times\":3},{\"id\":746386,\"sid\":12399,\"itemId\":\"minditem3\",\"price\":750,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":3,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":91,\"type\":[\"T\",\"D\"],\"update_time\":\"2026-08-26 17:12:35\",\"gid\":400010,\"itype\":6,\"name\":\"凝心露\",\"dsc\":\"翠绿透彻的玉瓶中装着的半透明药液，闻之清香阵阵，凝心露功效颇为奇特，服用令可人心神饱满全身清爽。\",\"times\":3},{\"id\":746387,\"sid\":12399,\"itemId\":\"glczwanquanchongzhi001\",\"price\":150,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":10,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":84,\"type\":[\"T\",\"D\"],\"update_time\":\"2026-08-26 17:12:35\",\"gid\":400011,\"itype\":5,\"name\":\"复思之书\",\"dsc\":\"此乃复思之书，使用该书卷可以将任何招式完全重置。但招式品质不会发生变化。\",\"times\":10},{\"id\":746388,\"sid\":12399,\"itemId\":\"glczwanquanchongzhi002\",\"price\":50,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":10,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":85,\"type\":[\"T\",\"D\"],\"update_time\":\"2026-08-26 17:12:35\",\"gid\":400012,\"itype\":5,\"name\":\"弃定之书\",\"dsc\":\"此乃弃定之书，使用该书卷可以将精妙招式完全重置，但招式品质不会发生变化。\",\"times\":10},{\"id\":746389,\"sid\":12399,\"itemId\":\"glczwanquanchongzhi003\",\"price\":75,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":10,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":86,\"type\":[\"T\",\"D\"],\"update_time\":\"2026-08-26 17:12:35\",\"gid\":400013,\"itype\":5,\"name\":\"重思之书\",\"dsc\":\"此乃重思之书，使用该书卷可以将超凡招式完全重置，但招式品质不会发生变化。\",\"times\":10},{\"id\":746390,\"sid\":12399,\"itemId\":\"gailiangshengpin002\",\"price\":125,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":2,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":88,\"type\":[\"T\",\"D\"],\"update_time\":\"2026-08-26 17:12:35\",\"gid\":400015,\"itype\":5,\"name\":\"超群之书\",\"dsc\":\"此乃超群之书，使用该书卷可以将普通招式提升至超凡招式。\",\"times\":2},{\"id\":746391,\"sid\":12399,\"itemId\":\"gailiangshengpin004\",\"price\":85,\"number\":1,\"is_again\":\"N\",\"extra\":{\"limit\":3,\"start\":\"2021-01-01 00:00:00\",\"end\":\"2026-09-30 23:59:59\"},\"is_inherit\":\"Y\",\"inde\":87,\"type\":[\"T\",\"D\"],\"update_time\":\"2026-08-26 17:12:35\",\"gid\":400016,\"itype\":5,\"name\":\"跃兴之书\",\"dsc\":\"此乃跃兴之书，使用该书卷可以将精妙招式提升至超凡招式。\",\"times\":3}]},\"typeName\":{\"tuijian\":{\"name\":\"推荐\",\"index\":1},\"shuxing\":{\"name\":\"属性\",\"index\":2},\"wuxue\":{\"name\":\"武学\",\"index\":3},\"shenbing\":{\"name\":\"神兵\",\"index\":4},\"guashi\":{\"name\":\"挂饰\",\"index\":5},\"mianju\":{\"