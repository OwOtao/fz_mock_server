     "content": {
      "size": 2040,
      "mimeType": "text/plain",
      "text": "{\"errcode\":0,\"data\":{\"id\":1,\"name\":\"首充活动\",\"desc\":\"首次充值，3天登录好礼领不停。\",\"gift\":\"面具、潜能丹、武功秘籍、菩提子\",\"start\":1499392800,\"end\":1798732799,\"status\":1,\"is_open\":1,\"is_show\":1,\"detail_desc\":[\"玩家首次充值送好礼！只要玩家满足对应的首充条件，则可以连续3天登录游戏，都可以获得丰厚好礼。\",\"传承或重置都将使活动进度清空。\"],\"sort\":\"100\",\"create_time\":\"2017-04-07 18:40:49\",\"update_time\":\"2025-11-12 15:37:47\",\"activity_id\":\"shouchong\",\"rule_desc\":[\"1.大侠首次充值金额达到6元，即可解锁首充活动奖励，当天开始即可在活动界面领取丰厚奖励，持续三天。\",\"2.双存档互不影响。\",\"3.传承保留活动获得的奖励，不保留活动进度。\",\"4.重置不保留活动获得的奖励，不保留活动进度。\"],\"hasup\":0,\"base\":[{\"day\":1,\"status\":0,\"desc\":\"潜能丹*2\\n菩提子*2\\n五煞神掌*1\\n碎银*10000\",\"reward\":[{\"name\":\"潜能丹\",\"num\":2,\"itemId\":\"qiannengdan\",\"type\":1},{\"name\":\"菩提子\",\"num\":2,\"itemId\":\"putizi1\",\"type\":1},{\"name\":\"五煞神掌\",\"num\":1,\"itemId\":\"chunjieleiji1\",\"type\":1},{\"name\":\"碎银\",\"num\":10000,\"itemId\":\"money\",\"type\":2}]},{\"day\":2,\"status\":0,\"desc\":\"遁地符*20\\n分身符*20\\n潜能丹*2\\n天香玉露*2\",\"reward\":[{\"name\":\"遁地符\",\"num\":20,\"itemId\":\"dundifu\",\"type\":1},{\"name\":\"分身符\",\"num\":20,\"itemId\":\"fenshenfu\",\"type\":1},{\"name\":\"潜能丹\",\"num\":2,\"itemId\":\"qiannengdan\",\"type\":1},{\"name\":\"天香玉露\",\"num\":2,\"itemId\":\"tianxiangyulu1\",\"type\":1}]},{\"day\":3,\"status\":0,\"desc\":\"戏曲面具(岳小妹)*1\\n潜能丹*2\\n门派顶级残页*1\\n散人顶级残页*1\",\"imagePath\":\"Image\\/UI\\/AttrUI\\/mianju\\/yuelingsan2.png\",\"reward\":[{\"name\":\"戏曲面具(岳小妹)\",\"num\":1,\"itemId\":\"mianju1011\",\"type\":1},{\"name\":\"潜能丹\",\"num\":2,\"itemId\":\"qiannengdan\",\"type\":1},{\"name\":\"门派顶级残页\",\"num\":1,\"itemId\":\"menpaicanye4\",\"type\":1},{\"name\":\"散人顶级残页\",\"num\":1,\"itemId\":\"sanren8\",\"type\":1}]}]},\"rand_t\":1788274245.2428}"
