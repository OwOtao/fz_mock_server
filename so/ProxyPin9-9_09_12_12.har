ta\\\":{\\\"hide\\\":0,\\\"index\\\":121},\\\"uniqueId\\\":\\\"7496513735154991114\\\",\\\"musicName\\\":\\\"主按钮点击\\\",\\\"musicKey\\\":\\\"normaClick\\\",\\\"channelId\\\":\\\"effect1\\\",\\\"id\\\":\\\"22dc50f149b5fc7ff5e96a48f76d044b\\\"},{\\\"musicKey\\\":\\\"wrong\\\",\\\"channelId\\\":\\\"effect1\\\",\\\"musicUrl\\\":{\\\"fileName\\\":\\\"wrong.m4a\\\",\\\"category\\\":\\\"audio\\\",\\\"coverUrl\\\":\\\"https://lf3-static.bytednsdoc.com/obj/eden-cn/zvtheh7pfpenuhog/cyber_logo/music.png\\\",\\\"url\\\":\\\"https://lf-magic-cdn.bytetos.com/obj/magic-cn/cubic/cubic_iqmql/wrong.e4c51ce6e5bb0ec29417e2b639fd1b18.m4a\\\"},\\\"__meta\\\":{\\\"hide\\\":0,\\\"index\\\":91},\\\"id\\\":\\\"5bcc1ff37ad3b5e41cc27b36fcd4a51a\\\",\\\"uniqueId\\\":\\\"7496409018622017545\\\",\\\"musicName\\\":\\\"答错\\\"},{\\\"channelId\\\":\\\"effect1\\\",\\\"musicKey\\\":\\\"correct\\\",\\\"musicName\\\":\\\"答对\\\",\\\"musicUrl\\\":{\\\"fileName\\\":\\\"correct.m4a\\\",\\\"category\\\":\\\"audio\\\",\\\"coverUrl\\\":\\\"https://lf3-static.bytednsdoc.com/obj/eden-cn/zvtheh7pfpenuhog/cyber_logo/music.png\\\",\\\"url\\\":\\\"https://lf-magic-cdn.bytetos.com/obj/magic-cn/cubic/cubic_iqmql/correct.7d34f0bda4211fc579129022b2914e94.m4a\\\"},\\\"__meta\\\":{\\\"hide\\\":0,\\\"index\\\":61},\\\"id\\\":\\\"cb4a36b9680549f354deb12a1ac929ac\\\",\\\"uniqueId\\\":\\\"7496408900111958043\\\"}],\\\"__version\\\":1}\",\"daily_rank_lynx_scheme\":\"sslocal://webcast_lynxview?url=https%3A%2F%2Flf-webcast-sourcecdn-tos.bytegecko.com%2Fobj%2Fbyte-gurd-source%2F10181%2Fgecko%2Fresource%2Frevenue_rank_list_saas%2Fpages%2Fdailyrank_rank%2Ftemplate.js%3FinitialProps%3D%255B%2522current_room%2522%252C%2522current_user%2522%252C%2522linkmic%2522%252C%2522setting%253Areturn_back_settings%253Alogin_guide_config%253Alive_shop_rank_list_show%253Alive_rank_config%253Adaily_rank_new_comer_rank%2522%255D\\u0026gravity=bottom\\u0026type=popup\\u0026load_taro=0\\u0026rate_height=480\\u0026lynx_thread=2\\u0026window_floating=0\\u0026abandon_coordinate=1\\u0026enable_lynx_bg=1\",\"deco_text_modify_frequency\":5,\"diamond_exchange_url\":\"sslocal://webcast_lynxview?url=https%3A%2F%2Flf-webcast-sourcecdn-tos.bytegecko.com%2Fobj%2Fbyte-gurd-source%2Fwebcast%2Fmono%2Flynx%2Frevenue_revenue_wallet_saas%2Fpages%2Fdiamond_exchange%2Ftemplate.js%3Fsource%3Droom_in_gift_panel\\u0026hide_nav_bar=1\\u0026host=aweme\\u0026type=popup\\u0026gravity=bottom\\u0026height=522\\u0026show_dim=1\\u0026engine_type=new\",\"disable_game_lottery\":0,\"dns_opt_method\":0,\"draw_urls\":[{\"inner_url\":\"https://webcast-open.douyin.com/webcast/openapi/feed/?content_type=0\\u0026channel_id=160002\\u0026is_draw=1\",\"key\":\"*\",\"req_from\":\"*\"},{\"inner_url\":\"https://webcast-open.douyin.com/webcast/openapi/feed/?content_type=0\\u0026channel_id=162003\\u0026is_draw=1\",\"key\":\"live_channel_fm*\",\"req_from\":\"*\"},{\"inner_url\":\"https://webcast-open.douyin.com/webcast/openapi/feed/?content_type=0\\u0026channel_id=162006\\u0026is_draw=1\",\"key\":\"live_channel_chat*\",\"req_from\":\"*\"},{\"inner_url\":\"https://webcast-open.douyin.com/webcast/openapi/feed/?content_type=0\\u0026channel_id=162004\\u0026is_draw=1\",\"key\":\"live_channel_city*\",\"req_from\":\"*\"},{\"inner_url\":\"https://webcast-open.douyin.com/webcast/openapi/feed/?content_type=0\\u0026channel_id=162002\\u0026is_draw=1\",\"key\":\"live_channel_voice*\",\"req_from\":\"*\"},{\"inner_url\":\"https://webcast-open.douyin.com/webcast/openapi/feed/?content_type=0\\u0026channel_id=162001\\u0026is_draw=1\",\"key\":\"live_channel_main_tab\",\"req_from\":\"*\"},{\"inner_url\":\"https://webcast-open.douyin.com/webcast/openapi/feed/?content_type=0\\u0026channel_id=162001\\u0026is_draw=1\",\"key\":\"live_channel_live*\",\"req_from\":\"*\"}],\"drawer_hot\":\"https://webcast-open.douyin.com/webcast/openapi/feed/?content_type=0\\u0026channel_id=161001\",\"drawer_hot_task\":\"https://webcast-open.douyin.com/webcast/openapi/feed/?content_type=0\\u0026channel_id=165001\",\"drawer_multi_tab_enable\":false,\"ec_live_auction_add_btm_list\":1,\"ec_live_enable_enter_request\":0,\"ec_live_promotion_enhance_introduce_effect\":false,\"ec_live_use_new_flash_dialog\":true,\"ecom_fe_coverage\":\"{\\\"shipping_apply_lynx\\\":{\\\"enable\\\":true,\\\"sample_rate\\\":0.001},\\\"express_pia\\\":{\\\"enable\\\":true,\\\"sample_rate\\\":0.001}}\",\"ecom_live_product_rank_ruler\":[{\"content\":\"- 抖音电商直播间带货榜是根据真实数据进行排名的直播间排行榜，希望帮助消费者通过榜单找到正在直播的好商品，让选择更简单。直播间排名越靠前曝光机会越大。\",\"title\":\"直播间带货榜\"},{\"content\":\"- 直播间带货榜当前分为总榜、抖音旗舰榜、特色主题榜、国家补贴榜、商品类目榜，榜单形态持续更新中：\\n- 总榜：按照上榜规则对全部电商直播间进行排序展示\\n- 抖音旗舰榜：聚合抖音旗舰店铺热销直播间进行排序展示\\n- 特色主题榜：由抖音电商运营就特色主题或活动，按照特定规则对直播间进行圈选后排序展示\\n- 国家补贴榜：聚合正在直播国家补贴商品的直播间进行排序展示\\n- 商品类目榜：按照直播间在播商品所属类目对相关直播间进行排序后展示\",\"title\":\"榜单介绍\"},{\"content\":\"- 上榜直播间均为正在直播的直播间\\n- 上榜作者基础要求：近30天无虚假交易处罚记录，近14天退单率无异常、无严重违规记录\\n- 排序规则：以该直播间所售卖商品的【带货力、互动力、吸引力】进行综合排名，每小时结算\",\"title\":\"上榜规则\"},{\"content\":\"- 带货力：根据单位时间内的交易额、交易量等数据指标综合评估直播间主播的带货能力\\n- 互动力：根据单位时间内的直播间观看时长、分享率、评论率等数据指标综合评估直播间的互动氛围\\n- 吸引力：根据单位时间内购买商品的新用户数、新增粉丝数等数据指标综合评估直播间对平台用户的吸引力\",\"title\":\"指标解读\"},{\"content\":\"- 为保证榜单时效性，榜单每小时进行动态更新。由于技术等原因，榜单更新时间偶有延迟，具体更新时间以实际情况为准。\\n- 直播间榜单会露出商品名称和商品标签。所有的上榜直播间都会展示一款商品，并露出对应的商品名称。同时，结合商品名称的露出，会露出唯一的商品标签，该标签由算法选取商品详情页的商品已有标签作为候选，不同的用户看到的标签不尽相同。整体上，商品标签的露出是为了给用户提供更多的决策理由，帮助更快的找到合适的直播间/商品。\\n- 榜单排名旁的说明属于热度值标签，用于鼓励榜单中前3名的直播间和整体数据表现较好的直播间。热度标签只有三种，分别为：蝉联榜首、持续霸榜、排名飙升。每个直播间最多展示一种标签，若同一直播间同时获得多种热度标签，则按算法筛选展示唯一标签。\\n- 平台将实时监控上榜直播间的数据表现，若发现直播间有刷单、互动异常、售卖假冒盗版商品等违规作弊行为，将立即对违规直播间进行下榜。低质作者、近期有虚假交易判罚、假货山寨判罚、直播间有处罚消息的作者均会有一定的上榜限制，请务必诚信经营、用心直播。\",\"title\":\"补充说明\"}],\"ecom_live_scene_id_allow_list\":[\"1001\",\"1003\",\"1031\",\"1098\",\"1099\",\"1046\",\"1091\",\"1092\",\"1473\",\"1082\",\"1086\",\"1087\",\"1112\",\"1491\",\"1493\"],\"enable_all_service_reuse\":0,\"enable_audio_focus_backgound\":false,\"enable_broadcast_guest_list_update\":false,\"enable_latch\":0,\"enable_link_plugin_pre_load\":1,\"enable_live_feed_dynamic_config_v2\":true,\"enab